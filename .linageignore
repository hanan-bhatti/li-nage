# Li'nage ignore file
# This file works like .gitignore but is specific to Li'nage
# Patterns here override .gitignore patterns

# Li'nage metadata (always ignored)
.linage/

# Git metadata (always ignored)
.git/

# Patterns imported from .gitignore:
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
project.lock.json
project.fragment.lock.json
artifacts/
ScaffoldingReadMe.txt
*.nupkg
*.snupkg
~$*
*~
CodeCoverage/
*.binlog
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
